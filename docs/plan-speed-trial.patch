+	const size_t kSbaMax = 512, kSbaStep = 16, kSbaPage = 65536, kSbaReserve = 640u * 1024 * 1024;
+	struct SbaNode { SbaNode* pNext; };
+	SbaNode* s_apSbaFree[kSbaMax / kSbaStep + 1];
+	BYTE* s_apSbaCur[kSbaMax / kSbaStep + 1];
